## .NET / C# gitignore

# Build outputs
bin/
obj/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet packages (restored on build)
*.nupkg
*.snupkg
packages/
project.lock.json

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Publish output
publish/
out/

# Rider
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini
